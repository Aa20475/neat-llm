CRUSOE_API_KEY=
CRUSOE_BASE_URL=https://api.inference.crusoecloud.com/v1
# Verify availability with the live catalog when configuring another account.
CRUSOE_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# Blank means no app-imposed response token cap; provider defaults still apply.
CRUSOE_MAX_TOKENS=
CRUSOE_TIMEOUT_SECONDS=45
